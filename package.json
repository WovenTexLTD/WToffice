{
  "name": "wtoffice",
  "private": true,
  "version": "0.1.0",
  "description": "WovenTex virtual office \u2014 spatial 2D workspace with proximity audio",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @wtoffice/server",
    "dev:web": "npm run dev -w @wtoffice/web",
    "build": "npm run build -w @wtoffice/web",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p web --noEmit",
    "verify:floor": "tsx tools/verify-floor.ts",
    "smoke": "tsx tools/smoke-test.ts",
    "models:optimise": "node tools/optimise-models.mjs",
    "shoot": "node tools/shoot.mjs",
    "shoot:tasks": "node tools/shoot-tasks.mjs",
    "forget-devices": "npm run forget-devices -w @wtoffice/server",
    "tunnel": "cloudflared tunnel --url http://localhost:3001",
    "perf": "node tools/perf.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "concurrently": "^9.1.2",
    "fbx2gltf": "^0.9.7-p1",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
