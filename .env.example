
# Notion — /task in any channel files a row in the Tasks database.
# Create an internal integration at notion.so/my-integrations, then share the
# Tasks database with it (••• → Connections). Without these, /task replies
# saying it is not connected and nothing else changes.
NOTION_TOKEN=
NOTION_TASKS_DB=e17b1734-ceaf-8236-a5cb-815a3a49cad0
# Which Category and Status new tasks get. Must exist in the database.
NOTION_TASK_CATEGORY=WT
NOTION_TASK_STATUS=To Do

# Shared passphrase. Unset means anyone who can reach the port can walk in,
# which is right for localhost and wrong for anything reachable from outside.
OFFICE_KEY=

# ── Voice relay (TURN) ──────────────────────────────────────────────────────
# Optional, and only matters once two people are on different networks. STUN
# alone works for most home routers; behind a symmetric or carrier-grade NAT it
# does not, and the failure is silent — both sides connected, neither hearing
# anything. Leave blank for local development, where it can never be needed.
#
# Either static credentials from a provider (Metered, Twilio, your own coturn):
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Or Cloudflare, which mints a fresh short-lived set per session — preferred,
# because what the browser holds then expires by itself:
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
