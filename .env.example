
# Notion — /task in any channel files a row in the Tasks database.
# Create an internal integration at notion.so/my-integrations, then share the
# Tasks database with it (••• → Connections). Without these, /task replies
# saying it is not connected and nothing else changes.
NOTION_TOKEN=
NOTION_TASKS_DB=e17b1734-ceaf-8236-a5cb-815a3a49cad0
# Which Category and Status new tasks get. Must exist in the database.
NOTION_TASK_CATEGORY=WT
NOTION_TASK_STATUS=To Do
